@model IEnumerable<Participant>
@{
    ViewData["Title"] = "Registrations";
    var events = ViewBag.Events as List<Event> ?? new List<Event>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h2 mb-1">Registered Participants</h1>
        <p class="text-muted mb-0">All temporary registrations currently stored by the application.</p>
    </div>
    <a asp-action="Register" class="btn btn-primary">+ New Registration</a>
</div>

@if (TempData["RegistrationMessage"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>Registration Confirmed!</strong> @message
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Participant ID</th>
                    <th>Participant Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Year</th>
                    <th>Event</th>
                    <th>Registration Status</th>
                    <th>Registration Fee</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var participant in Model)
            {
                var eventItem = events.FirstOrDefault(e => e.EventName.Equals(participant.EventName, StringComparison.OrdinalIgnoreCase));
                <tr>
                    <td>@participant.ParticipantId</td>
                    <td class="fw-semibold">@participant.ParticipantName</td>
                    <td>@participant.Email</td>
                    <td>@participant.Department</td>
                    <td>@participant.Year</td>
                    <td>@participant.EventName</td>
                    <td><span class="badge @participant.GetStatusBadgeClass()">@participant.GetRegistrationStatus()</span></td>
                    <td>@(eventItem?.RegistrationFee.ToString("C") ?? "N/A")</td>
                    <td><a asp-action="Details" asp-route-id="@participant.ParticipantId" class="btn btn-sm btn-outline-primary">Details</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-4">No participants have registered yet.</div>
}
